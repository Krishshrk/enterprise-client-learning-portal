# Local development only. Production must use a secrets manager and approved SSO.
AZENTIO_ENV=development
AZENTIO_DB_PATH=backend/azentio.db
AZENTIO_DEMO_SEED=true
AZENTIO_DEMO_PASSWORD=Demo-Portal-2026!
AZENTIO_MIN_SHARED_COHORT=3
AZENTIO_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional: enables evidence-grounded AIRA summaries. Keep this key server-side.
# Create a key in the Groq console; without it AIRA uses deterministic retrieval.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Required in production; generate at least 32 random characters.
# AZENTIO_SESSION_SECRET=
